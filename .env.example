# Copy to .env and fill in. Never commit .env.
# Model for every agent in ventureos-api and ventureos-pipeline, and for the Research and GTM
# commands (default: claude-haiku-5-5).
# A claude-* ID uses Anthropic (ANTHROPIC_API_KEY).
RESEARCH_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
# Optional
RESEARCH_DATABASE_URL=
# Optional infrastructure (docker compose sets all 3). Without them, chats and jobs live in memory.
# REDIS_URL: locks, job progress, open chats, and gateway rate limits.
REDIS_URL=
# KAFKA_BOOTSTRAP_SERVERS: queue chat turns for ventureos-worker (needs REDIS_URL and RESEARCH_DATABASE_URL).
KAFKA_BOOTSTRAP_SERVERS=
# Gateway (ventureos-gateway): leave GATEWAY_API_KEY empty for no key.
GATEWAY_UPSTREAM=http://127.0.0.1:8000
GATEWAY_API_KEY=
# Optional: model for the standalone PM command (ventureos-pm) only. It always uses Claude.
# PM_MODEL=claude-haiku-5-5
# Experimental: a gemini-* RESEARCH_MODEL uses Gemini (GEMINI_API_KEY). Research then runs its
# simpler built-in loop instead of DeepAgents, and PM uses its JSON planner only.
GEMINI_API_KEY=
