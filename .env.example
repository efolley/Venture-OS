# Copy to .env and fill in. Never commit .env.
# Model for every agent in ventureos-api and ventureos-pipeline, and for the Research and GTM
# commands (default: claude-haiku-5-5).
# A claude-* ID uses Anthropic (ANTHROPIC_API_KEY).
RESEARCH_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
# Optional
RESEARCH_DATABASE_URL=
# Optional: model for the standalone PM command (ventureos-pm) only. It always uses Claude.
# PM_MODEL=claude-haiku-5-5
# Experimental: a gemini-* RESEARCH_MODEL uses Gemini (GEMINI_API_KEY). Research then runs its
# simpler built-in loop instead of DeepAgents, and PM uses its JSON planner only.
GEMINI_API_KEY=
